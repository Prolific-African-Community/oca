# PostgreSQL connection used by the application (a pooled Neon URL is suitable).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct, non-pooled PostgreSQL connection used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Required in production. Generate a long random value; changing it signs users out.
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional AI features. Keep the key server-side; leave blank to disable AI gracefully.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Optional seed override. The development-only fallback is documented in README.md.
SEED_PASSWORD="replace-for-demo-environments"
